<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="#BEB9B2"
    android:background="#BEB9B2"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="節拍器"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:backgroundTint="#BEB9B2"
            android:padding="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBpmLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="速度"
                    android:textSize="14sp"
                    android:textColor="#666666" />

                <TextView
                    android:id="@+id/tvBpm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnDecBpm"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:text="−" />

                <Button
                    android:id="@+id/btnIncBpm"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBpm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="214" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每小節拍數"
                android:textSize="14sp"
                android:textColor="#666666" />

            <View
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnDecBeats"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="−" />

            <TextView
                android:id="@+id/tvBeats"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:text="4"
                android:textSize="20sp"
                android:gravity="center"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp" />

            <Button
                android:id="@+id/btnIncBeats"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:text="+" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/beatGridContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拍子視覺"
                android:textSize="14sp"
                android:textColor="#666666"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:id="@+id/beatGrid"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="18dp">

            <Button
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="開始" />

            <View android:layout_width="12dp" android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnTap"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="拍子速度" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="提示：BPM 範圍 30–244。按下開始後會播放拍子聲，並在每小節第一拍發送同步標記（若已連線）。"
            android:textSize="12sp"
            android:textColor="#777777"
            android:layout_marginTop="12dp"
            android:paddingBottom="18dp" />

    </LinearLayout>
</ScrollView>
